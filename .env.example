# Copy this file to .env and fill in your real values (for local `node dev.js` testing).
# When you deploy to Vercel, you'll paste these same values into
# Vercel Project Settings -> Environment Variables instead — never commit a real .env.

# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" URI (port 6543) — works better with serverless functions.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.pooler.supabase.com:6543/postgres

# Any long random string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Only used by dev.js for local testing
PORT=5000
